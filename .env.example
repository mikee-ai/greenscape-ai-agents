# ─────────────────────────────────────────────────────────────────────
# Greenscape AI Agents — environment reference
# ─────────────────────────────────────────────────────────────────────
# This project runs on Cloudflare Workers. App secrets are provided two ways:
#   • Local dev:   copy `.dev.vars.example` -> `.dev.vars`  (used by `wrangler dev`)
#   • Production:  `wrangler secret put <NAME>`             (encrypted at rest)
#
# The values below document every variable the app reads.
# ─────────────────────────────────────────────────────────────────────

# ── Deploy credentials (used by the wrangler CLI, not the app at runtime) ──
CLOUDFLARE_API_TOKEN=          # scopes: Workers Scripts:Edit, D1:Edit, Zone DNS:Edit (mikee.ai)
CLOUDFLARE_ACCOUNT_ID=

# ── App secrets (set via `wrangler secret put`) ───────────────────────
ANTHROPIC_API_KEY=            # Claude (Haiku extraction + Sonnet drafting) — REQUIRED
AWS_ACCESS_KEY_ID=            # IAM user with ses:SendEmail
AWS_SECRET_ACCESS_KEY=
PAYPAL_CLIENT_ID=             # PayPal app (Sandbox) client id
PAYPAL_CLIENT_SECRET=
ADMIN_PASSWORD=               # shared password for the internal admin UI

# ── Non-secret config (lives in wrangler.jsonc [vars]) ────────────────
PUBLIC_BASE_URL=https://licenseandscale.mikee.ai
AWS_REGION=us-east-1
SES_FROM=proposals@mikee.ai
PAYPAL_ENV=sandbox            # sandbox | live
