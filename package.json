{
  "name": "greenscape-ai-agents",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Speed-to-Quote + Closed-Lost Reactivation AI agents for Greenscape Pro (License & Scale take-home)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply greenscape --local",
    "db:migrate:remote": "wrangler d1 migrations apply greenscape --remote",
    "db:seed:local": "wrangler d1 execute greenscape --local --file=./seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute greenscape --remote --file=./seed/seed.sql",
    "cf-typegen": "wrangler types",
    "build:node": "esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --jsx=automatic --jsx-import-source=hono/jsx --outfile=dist/server.mjs",
    "start:node": "node dist/server.mjs",
    "db:setup:node": "node scripts/db-setup.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@hono/node-server": "^2.0.4",
    "@libsql/client": "^0.17.3",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "markdown-it": "^14.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.13",
    "@cloudflare/workers-types": "^4.20260605.1",
    "@types/markdown-it": "^14.1.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.98.0"
  }
}
